# Copy to .env and change every value marked CHANGE-ME.
#   cp .env.example .env
#
# .env is gitignored AND dockerignored. Never commit a real one.
# In Kubernetes these come from a ConfigMap (non-secret) and a Secret
# (database URL); in CI they come from GitHub secrets/OIDC.

# --- application ------------------------------------------------------------
APP_ENVIRONMENT=local          # local | dev | staging | prod
APP_DEBUG=false
APP_LOG_LEVEL=INFO             # DEBUG | INFO | WARNING | ERROR | CRITICAL
APP_LOG_JSON=true              # false for readable console output locally
APP_METRICS_ENABLED=true
APP_MAX_PAGE_SIZE=100

# --- database ---------------------------------------------------------------
# One DSN rather than five fields: it is what SQLAlchemy, Alembic and every
# managed Postgres already speak, so there is one secret to rotate, not five.
APP_DATABASE_URL=postgresql+psycopg://app:CHANGE-ME@db:5432/app
APP_DB_POOL_SIZE=5
APP_DB_MAX_OVERFLOW=10
APP_DB_ECHO=false

# --- postgres container -----------------------------------------------------
POSTGRES_USER=app
POSTGRES_PASSWORD=CHANGE-ME
POSTGRES_DB=app

# --- host port mappings (change if something already owns the port) ---------
HTTP_PORT=8080
API_PORT=8000
POSTGRES_PORT=5432
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
LOKI_PORT=3100
ADMINER_PORT=8081

# --- grafana ----------------------------------------------------------------
GRAFANA_USER=admin
GRAFANA_PASSWORD=CHANGE-ME

# --- integration tests (optional) -------------------------------------------
# TEST_POSTGRES_DSN=postgresql+psycopg://app:CHANGE-ME@localhost:5432/app
